import { readdir, readFile, writeFile } from "node:fs/promises";
import { join, relative, resolve, sep } from "node:path";

// Embeds the vendored skill pack as data so every bundler (npm, VSIX, Desktop,
// runtime host) ships it without runtime file lookups. Run after updating
// packages/runtime/skills/superpowers; a runtime test fails on drift.
const root = resolve(import.meta.dirname, "..");
const pack = join(root, "packages/runtime/skills/superpowers");
const output = join(
  root,
  "packages/runtime/src/skills/superpowers-data.generated.ts",
);

async function files(directory: string): Promise<string[]> {
  const entries = await readdir(directory, { withFileTypes: true });
  const nested = await Promise.all(
    entries.map(async (entry) => {
      const path = join(directory, entry.name);
      if (entry.isSymbolicLink())
        throw new Error(`Vendored skills cannot contain symlinks: ${path}`);
      return entry.isDirectory() ? files(path) : [path];
    }),
  );
  return nested.flat();
}

const upstream = JSON.parse(
  await readFile(join(pack, "UPSTREAM.json"), "utf8"),
);
const skillFiles = (await files(join(pack, "skills")))
  .map((path) => relative(join(pack, "skills"), path).split(sep).join("/"))
  .sort();
const data: Record<string, string> = {};
for (const path of skillFiles)
  data[path] = await readFile(join(pack, "skills", ...path.split("/")), "utf8");

const source = `// Generated by scripts/generate-bundled-skills.mts. Do not edit.
// Superpowers ${upstream.origin} at ${upstream.revision}, MIT licensed.
export const superpowersPack = {
  origin: ${JSON.stringify(upstream.origin)},
  revision: ${JSON.stringify(upstream.revision)},
  license: ${JSON.stringify(await readFile(join(pack, "LICENSE"), "utf8"))},
  compatibility: ${JSON.stringify(await readFile(join(pack, "TRUSS-COMPATIBILITY.md"), "utf8"))},
  files: {
${skillFiles.map((path) => `    ${JSON.stringify(path)}: ${JSON.stringify(data[path])},`).join("\n")}
  } as Readonly<Record<string, string>>,
} as const;
`;
await writeFile(output, source);
console.log(
  `Wrote ${skillFiles.length} skill files to ${relative(root, output)}`,
);
