{
  "name": "@truss-harness/desktop",
  "version": "0.1.32",
  "description": "Standalone desktop client for the Truss runtime.",
  "author": "Truss Contributors",
  "desktopName": "truss-harness.desktop",
  "type": "module",
  "main": "./dist/main.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild ./dist/main.js --bundle --platform=node --format=cjs --external:electron --external:prettier --outfile=./dist/main.cjs && esbuild ./dist/preload.js --bundle --platform=node --format=cjs --external:electron --outfile=./dist/preload.cjs && esbuild ./dist/renderer.js --bundle --platform=browser --format=esm --outfile=./dist/renderer.bundle.js && node ./scripts/copy-static.mjs",
    "dev": "npm run build && node ./scripts/start-electron.mjs",
    "start": "node ./scripts/start-electron.mjs",
    "package": "npm run build && electron-builder --publish never",
    "package:win:all": "npm run build && electron-builder --publish never --win nsis --x64 --arm64",
    "package:win:x64": "npm run build && electron-builder --publish never --win nsis --x64",
    "package:win:arm64": "npm run build && electron-builder --publish never --win nsis --arm64",
    "package:linux:x64": "npm run build && electron-builder --publish never --linux deb rpm pacman dir --x64",
    "package:linux:arm64": "npm run build && electron-builder --publish never --linux deb rpm pacman dir --arm64"
  },
  "build": {
    "appId": "com.truss-harness.desktop",
    "productName": "Truss",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "truss-agent",
        "repo": "truss-harness"
      }
    ],
    "win": {
      "icon": "./assets/brand-logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "./assets/brand-logo-512.png",
      "syncDesktopName": true,
      "category": "Development",
      "synopsis": "Local-first coding agent workspace",
      "description": "Desktop workspace for local coding models with chat, tools, Git, terminal, editor, and approval controls.",
      "vendor": "Truss Contributors",
      "maintainer": "Truss Contributors",
      "executableName": "truss-harness",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "pacman": {
      "compression": "zstd",
      "depends": [
        "gtk3",
        "nss",
        "libnotify",
        "libxss",
        "libxtst",
        "xdg-utils",
        "at-spi2-core",
        "libsecret"
      ]
    }
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/truss-agent/truss-harness.git"
  },
  "dependencies": {
    "@truss-harness/agent-host": "0.1.6",
    "@truss-harness/gateway": "0.1.10",
    "@types/qrcode": "^1.5.6",
    "electron-updater": "^6.3.9",
    "highlight.js": "11.11.1",
    "prettier": "3.6.2",
    "qrcode": "^1.5.4",
    "@truss-harness/branding": "0.1.1",
    "@truss-harness/cli": "0.1.18",
    "@truss-harness/mcp": "0.1.10",
    "@truss-harness/provider-openai-compatible": "0.1.11",
    "@truss-harness/runtime": "0.1.10"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0"
  },
  "bugs": {
    "url": "https://github.com/truss-agent/truss-harness/issues"
  },
  "homepage": "https://github.com/truss-agent/truss-harness#readme"
}
