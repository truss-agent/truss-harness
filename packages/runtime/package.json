{
  "name": "@truss-harness/runtime",
  "version": "0.1.15",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/bundled/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "logo.png",
    "skills/superpowers/LICENSE",
    "skills/superpowers/UPSTREAM.json",
    "skills/superpowers/TRUSS-COMPATIBILITY.md"
  ],
  "scripts": {
    "build": "tsc -b && node --experimental-strip-types ../../scripts/bundle-published-package.mts runtime",
    "prepack": "npm run build && node ../../scripts/clean-publish-tests.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.15.1"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/truss-agent/truss-harness.git"
  },
  "bugs": {
    "url": "https://github.com/truss-agent/truss-harness/issues"
  },
  "homepage": "https://github.com/truss-agent/truss-harness#readme",
  "keywords": [
    "ai",
    "agent-runtime",
    "coding-agent",
    "local-first"
  ],
  "dependencies": {
    "@truss-harness/branding": "0.1.1"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "undici": "^7.30.1"
  }
}
