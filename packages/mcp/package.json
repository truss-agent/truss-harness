{
  "name": "@truss-harness/mcp",
  "version": "0.1.12",
  "description": "Model Context Protocol client adapter for Truss.",
  "type": "module",
  "main": "./dist/bundled/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/bundled/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node --experimental-strip-types ../../scripts/bundle-published-package.mts mcp",
    "prepack": "npm run build && node ../../scripts/clean-publish-tests.mjs",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "logo.png"
  ],
  "engines": {
    "node": ">=22.15.1"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/truss-agent/truss-harness.git"
  },
  "bugs": {
    "url": "https://github.com/truss-agent/truss-harness/issues"
  },
  "homepage": "https://github.com/truss-agent/truss-harness#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@truss-harness/runtime": "^0.1.15"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@hono/node-server": "^2.1.5",
    "zod": "^4.6.7"
  }
}
